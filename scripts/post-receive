#!/usr/bin/env bash
# Installed as origin.git/hooks/post-receive
# When main is updated, deploy the new tip into wp-staging and activate the plugin.
set -euo pipefail

# When this hook lives at $PIPELINE_ROOT/origin.git/hooks/post-receive,
# two directories up is PIPELINE_ROOT. Override with PIPELINE_ROOT or
# pipeline.ini if needed. Leave PIPELINE_ROOT unset here so
# pipeline-common.sh can apply config-file values, then defaults.
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_HOOK_ROOT_GUESS="${PIPELINE_ROOT:-$(cd "$HOOK_DIR/../.." && pwd)}"
if [[ -f "$_HOOK_ROOT_GUESS/scripts/pipeline-common.sh" ]]; then
  # shellcheck source=pipeline-common.sh
  source "$_HOOK_ROOT_GUESS/scripts/pipeline-common.sh"
else
  PIPELINE_ROOT="$_HOOK_ROOT_GUESS"
  PIPELINE_LOG_DIR="${PIPELINE_LOG_DIR:-$PIPELINE_ROOT/logs}"
fi
DEPLOY="$PIPELINE_ROOT/scripts/deploy-env.sh"
PIPELINE_LOG_DIR="${PIPELINE_LOG_DIR:-$PIPELINE_ROOT/logs}"
LOG="$PIPELINE_LOG_DIR/post-receive.log"
mkdir -p "$PIPELINE_LOG_DIR"

{
  echo "[$(date '+%Y-%m-%d %H:%M:%S %Z')] post-receive start"
  echo "  PIPELINE_ROOT=$PIPELINE_ROOT"
  deployed=0
  while read -r oldrev newrev refname; do
    echo "  ref $refname $oldrev -> $newrev"
    if [[ "$refname" == "refs/heads/main" ]]; then
      echo "  main updated; deploying to staging"
      env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE "$DEPLOY" staging main
      deployed=1
    else
      echo "  skipping non-main ref $refname"
    fi
  done
  if [[ "$deployed" -eq 0 ]]; then
    echo "  no main update in this push; staging left unchanged"
  fi
  echo "[$(date '+%Y-%m-%d %H:%M:%S %Z')] post-receive end"
} >>"$LOG" 2>&1
